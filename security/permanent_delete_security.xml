<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_permanent_delete" model="ir.module.category">
        <field name="name">Permanent Data Delete</field>
        <field name="description">Access rights for permanently deleting POS, MRP, and Inventory records</field>
        <field name="sequence">95</field>
    </record>

    <record id="privilege_permanent_delete" model="res.groups.privilege">
        <field name="name">Permanent Data Delete</field>
        <field name="sequence">95</field>
        <field name="category_id" ref="module_category_permanent_delete"/>
    </record>

    <record id="group_permanent_delete_manager" model="res.groups">
        <field name="name">Manager: Allow Permanent Deletion</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_permanent_delete"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <!-- Automatically grant to System Administrators -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('permanent_data_cleanup.group_permanent_delete_manager'))]"/>
    </record>
</odoo>